# AWS
AWS_REGION=us-east-1
RAW_BUCKET=
CURATED_BUCKET=

# Secrets Manager secret name (JSON: {"api_key": "..."})
NEWS_SECRET_NAME=data-pipeline/news-api

# Hacker News' API is public and needs no key/auth.
HN_FEED=newstories
HN_STORY_LIMIT=50

# News ingestion tuning
NEWS_QUERY=cryptocurrency OR technology
NEWS_PAGE_SIZE=50
NEWS_LANGUAGE=en

# Set to true to write to ./local_output* instead of S3 (no AWS resources needed)
DRY_RUN=true

# RAG / CRAG (Bedrock) -- needed for rag/build_index.py, rag/query.py, eval/run_ragas.py
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_TEXT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
RAG_TOP_K=5
RAG_INDEX_KEY=rag-index/index.json

# Tavily web search (CRAG fallback when nothing local is relevant; tavily.com, free tier)
TAVILY_SECRET_NAME=data-pipeline/tavily-api
