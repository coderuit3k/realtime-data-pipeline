# AWS credentials for the least-privilege "web app" IAM user (see infra/README.md
# "Web app IAM user" section for how to create it).
AWS_ACCESS_KEY_ID=AKIAEXAMPLE0000000
AWS_SECRET_ACCESS_KEY=example-secret-access-key
AWS_REGION=us-east-1

# Athena workgroup + database used by the dashboard's live queries.
ATHENA_WORKGROUP=realtime-data-pipeline-dev-athena-workgroup
ATHENA_DATABASE=realtime_data_pipeline_dev_curated

# Real S3 bucket names (plain strings, not secrets) used by the Live
# Metrics & Ops dashboard to read real bucket storage size via
# CloudWatch. Get the real values with:
#   cd infra && terraform output raw_bucket_name && terraform output curated_bucket_name
RAW_BUCKET=realtime-data-pipeline-dev-raw-123456789012
CURATED_BUCKET=realtime-data-pipeline-dev-curated-123456789012

# CloudWatch alarm name prefix used to compute the dashboard's alarm counts.
# Also used by the Ops page to build Lambda/log-group/EventBridge-rule names,
# so this must be the exact pipeline name prefix (local.name_prefix), not just
# any prefix that happens to match the alarm names.
ALARM_NAME_PREFIX=realtime-data-pipeline-dev

# Name of the RAG agent Lambda function invoked by the assistant API route.
RAG_AGENT_FUNCTION_NAME=realtime-data-pipeline-dev-rag-agent

# Upstash Redis REST credentials used for assistant API rate limiting.
UPSTASH_REDIS_REST_URL=https://example-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=example-upstash-rest-token

# Supabase project backing the RAG Assistant's persisted conversations
# (see supabase/schema.sql for the migration to run once in the Supabase
# SQL editor). SERVICE_ROLE_KEY bypasses Row-Level Security -- server-only,
# never exposed to the client.
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=example-service-role-key

# Fine-grained GitHub PAT, read-only Actions permission, scoped to just
# this repo -- raises the GitHub API rate limit for the CI/CD page from
# 60/hour (unauthenticated) to 5,000/hour. Never write-scoped.
GITHUB_READ_TOKEN=github_pat_example0000000000000000

# Secret names (not values) for the Settings page's real, metadata-only
# "configured" check -- DescribeSecret only, never GetSecretValue.
# Vercel-side (this web app); distinct from the pipeline's own
# NEWS_SECRET_NAME/TAVILY_SECRET_NAME in the repo-root .env.example.
NEWS_SECRET_NAME=realtime-data-pipeline-dev/news-api
TAVILY_SECRET_NAME=realtime-data-pipeline-dev/tavily-api

# Real deployment environment name, matching Terraform's own
# `environment` variable (infra/variables.tf, default "dev") -- backs
# the sidebar's real "region · environment" status label.
DEPLOY_ENVIRONMENT=dev

# Cloudflare R2 credentials for uploading Excel export files and generating presigned download URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_EXCEL_BUCKET_NAME=
