# AWS credentials for the least-privilege "web app" IAM user (see infra/README.md
# "Web app IAM user" section for how to create it).
AWS_ACCESS_KEY_ID=AKIAEXAMPLE0000000
AWS_SECRET_ACCESS_KEY=example-secret-access-key
AWS_REGION=us-east-1

# Athena workgroup + database used by the dashboard's live queries.
ATHENA_WORKGROUP=realtime-data-pipeline-dev-athena-workgroup
ATHENA_DATABASE=realtime_data_pipeline_dev_curated

# CloudWatch alarm name prefix used to compute the dashboard's alarm counts.
# Also used by the Ops page to build Lambda/log-group/EventBridge-rule names,
# so this must be the exact pipeline name prefix (local.name_prefix), not just
# any prefix that happens to match the alarm names.
ALARM_NAME_PREFIX=realtime-data-pipeline-dev

# Names of the two RAG Lambda functions invoked by the assistant API route.
RAG_QUERY_FUNCTION_NAME=realtime-data-pipeline-dev-rag-query
RAG_AGENT_FUNCTION_NAME=realtime-data-pipeline-dev-rag-agent

# Upstash Redis REST credentials used for assistant API rate limiting.
UPSTASH_REDIS_REST_URL=https://example-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=example-upstash-rest-token

# Fine-grained GitHub PAT, read-only Actions permission, scoped to just
# this repo -- raises the GitHub API rate limit for the CI/CD page from
# 60/hour (unauthenticated) to 5,000/hour. Never write-scoped.
GITHUB_READ_TOKEN=github_pat_example0000000000000000
